VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=事務所管理システム

# P2-S3f 签证域主路径灰度（构建期）：未设置或 true 表示显示对应侧栏入口；false 仅隐藏侧栏/引导链接，路由深链仍可用。
# VITE_VISA_UI_VISA_PRIMARY_VISIBLE=false

# 新建客户保存成功后：是否用带操作按钮的成功提示引导进入签证案件（需具备签证 Tab 入口权限）。
# tab（默认）= 跳转客户详情签证 Tab「案件」子块；wizard = 同上并附加 openVisaCaseWizard=1 自动打开建案向导（需 visaCase:create）；off = 仅普通「客户已创建」提示。
# VITE_CUSTOMER_CREATE_VISA_NUDGE_MODE=tab
# VITE_CUSTOMER_CREATE_VISA_NUDGE_MODE=wizard
# VITE_CUSTOMER_CREATE_VISA_NUDGE_MODE=off
