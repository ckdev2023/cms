        <mxCell id="t0" value="客户中心业务流程 2.0&#xa;内部员工入口（非对客门户）· 时间按「期限与待办」切" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="520" height="48" as="geometry" />
        </mxCell>

        <mxCell id="pool1" value="1 进门第一眼（最想先看到什么）" style="swimlane;horizontal=0;startSize=28;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1420" height="132" as="geometry" />
        </mxCell>
        <mxCell id="p1a" value="今日 / 本周&#xa;要跟进的人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="pool1">
          <mxGeometry x="16" y="40" width="150" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p1b" value="在留 · 期限类&#xa;提醒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="pool1">
          <mxGeometry x="190" y="40" width="150" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p1c" value="进行中案件&#xa;「下一步该谁做」&#xa;与状态对齐（材料 / 提出·补正 / 预约）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="pool1">
          <mxGeometry x="364" y="32" width="220" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p1d" value="列表 / 卡片可信赖主档摘要&#xa;姓名·商号 · 联系方式 · 担当&#xa;主要在留或关键日期 · 当前主案件一句" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#0d47a1;fontStyle=0" vertex="1" parent="pool1">
          <mxGeometry x="608" y="32" width="280" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p1e" value="一眼筛出&#xa;「我现在该处理的那一批」&#xa;（筛选 / 工作台桶 / 提醒页）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;" vertex="1" parent="pool1">
          <mxGeometry x="912" y="32" width="200" height="88" as="geometry" />
        </mxCell>

        <mxCell id="pool2" value="2 留痕分工（交接时命根子）" style="swimlane;horizontal=0;startSize=28;fillColor=#fff8e1;strokeColor=#ff8f00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2a" value="客户备注 Tab&#xa;轻量备忘 · 不隶属于某一案件的信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;" vertex="1" parent="pool2">
          <mxGeometry x="16" y="36" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2b" value="签证域 → 案件日志（结构化）&#xa;谁·何时·对客户或入管的判断 · 下次何时跟&#xa;与案件绑定；与行政实务「进行到哪一步」对齐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#e65100;fontStyle=1" vertex="1" parent="pool2">
          <mxGeometry x="320" y="28" width="420" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p2c" value="文件 / 审计等跨模块留痕&#xa;（不仅客户中心）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=11;" vertex="1" parent="pool2">
          <mxGeometry x="760" y="36" width="220" height="56" as="geometry" />
        </mxCell>

        <mxCell id="pool3" value="3 典型一天：Hub 入口 → 客户详情（与实现对应）" style="swimlane;horizontal=0;startSize=28;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;" vertex="1" parent="1">
