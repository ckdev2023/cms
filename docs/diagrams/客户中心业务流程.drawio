  <diagram id="customer-center-flow" name="客户中心主流程">
    <mxGraphModel dx="1100" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="员工登录内部后台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="140" height="48" as="geometry" />
        </mxCell>
        <mxCell id="3" value="侧栏进入「客户中心」&#xa;（CustomerCenterLayout 顶栏 Tab）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="32" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="4" value="默认有签证工作台 Tab 时&#xa;根路径 /customers 常重定向至&#xa;签证工作台（可改 Tab）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="24" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="客户列表&#xa;筛选 / 排序 / 关键字&#xa;新建客户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="160" height="72" as="geometry" />
        </mxCell>
        <mxCell id="6" value="签证工作台 KPI&#xa;与案件桶" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="230" y="160" width="140" height="72" as="geometry" />
        </mxCell>
        <mxCell id="7" value="签证提醒页&#xa;（案件维度）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="140" height="72" as="geometry" />
        </mxCell>
        <mxCell id="8" value="全局案件登记册&#xa;等并列入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="570" y="160" width="150" height="72" as="geometry" />
        </mxCell>
        <mxCell id="9" value="主档在留「N日内」视图&#xa;（同列表组件 + 默认筛选）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="750" y="160" width="180" height="72" as="geometry" />
        </mxCell>
        <mxCell id="10" value="打开客户详情&#xa;/customers/:id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="280" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="11" value="基本信息 Tab&#xa;主档 / 个人或法人扩展" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="150" height="56" as="geometry" />
        </mxCell>
        <mxCell id="12" value="客户备注 Tab&#xa;轻量备忘（非案件日志）" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="380" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="13" value="签证域 Tab&#xa;（权限与开关控制）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="390" y="372" width="140" height="72" as="geometry" />
        </mxCell>
